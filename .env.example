# OCR and Vision Provider Configuration
# Supported providers: tesseract, vision_api, mock, none
OCR_PROVIDER=tesseract

# Path to local Tesseract executable if not in system PATH
TESSERACT_CMD=C:\Users\abhis\AppData\Local\Programs\Tesseract-OCR\tesseract.exe

# Vision API Configuration (Optional paid vision provider)
VISION_API_KEY=
VISION_API_ENDPOINT=https://api.openai.com/v1/chat/completions
VISION_MODEL_ID=gpt-4o-mini
VISION_REQUEST_TIMEOUT=15
VISION_MAX_RETRIES=2

# Application Settings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO
DEBUG=False

# Policy & Decision Thresholds
AMOUNT_AUTO_APPROVE_MAX=2000.0
AMOUNT_TOLERANCE_ABSOLUTE=10.0
DATE_TOLERANCE_DAYS=3
MIN_EXTRACTION_CONFIDENCE=0.60
